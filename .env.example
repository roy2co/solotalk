# גיבוי ענן (Firebase Storage) — אופציונלי.
# בלי המשתנים האלה, שכבת הענן רדומה וההקלטות נשמרות רק על המכשיר.
# ליצור פרויקט ב-https://console.firebase.google.com → Storage + Anonymous Auth,
# ולהעתיק את הערכים מ-Project settings → Web app.
# בפריסה ב-Netlify: להגדיר את אותם משתנים ב-Site settings → Environment variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
